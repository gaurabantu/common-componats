{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write(_fleet/**)",
      "Edit(_fleet/**)",
      "Write",
      "Edit",
      "Bash",
      "Bash(sh _fleet/scripts/validate-handoff.sh:*)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "component-author|screen-composer|compliance-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/_fleet/scripts/validate-handoff.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
